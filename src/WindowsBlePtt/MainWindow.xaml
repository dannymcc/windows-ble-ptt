<Window x:Class="WindowsBlePtt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsBlePtt.ViewModels"
        Title="BLE PTT"
        Height="640" Width="420"
        MinHeight="540" MinWidth="380"
        Background="{StaticResource Background}"
        Foreground="{StaticResource OnBackground}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,4,0,12">
            <TextBlock Text="BLE PTT" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left"/>
            <Border DockPanel.Dock="Right" CornerRadius="14" Padding="12,4"
                    Background="{StaticResource SurfaceElevated}"
                    Visibility="{Binding HasConnection, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
                <TextBlock Text="Ready" Foreground="{StaticResource Background}" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="18"
                BorderBrush="{StaticResource Outline}" BorderThickness="1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding StatusHeadline}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusSubline}" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Section label: paired button -->
        <TextBlock Grid.Row="2" Style="{StaticResource SectionLabel}"
                   Text="DISCOVERED" Visibility="{Binding HasDevicesOrScanning, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}"/>

        <!-- Discovered list -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="18"
                BorderBrush="{StaticResource Outline}" BorderThickness="1"
                Visibility="{Binding HasDevicesOrScanning, Converter={StaticResource BoolToVisible}, FallbackValue=Collapsed}">
            <ListBox ItemsSource="{Binding Discovered}"
                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Padding="0,6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="14,12"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource OnBackground}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock Text="Pair" Foreground="{StaticResource PillBlue}"
                                       FontWeight="SemiBold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SubtitleText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- TX indicator -->
        <Border Grid.Row="4" Margin="0,18,0,8" CornerRadius="28" Padding="0,38" HorizontalAlignment="Stretch">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Coral}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Coral}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="TX" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="5" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PillButton}"
                    Content="Scan for buttons" Click="OnScanClick"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource Invert}}"/>
            <Button Grid.Column="2" Style="{StaticResource PillButton}"
                    Content="Disconnect" Click="OnDisconnectClick"
                    IsEnabled="{Binding HasConnection}"/>
        </Grid>
    </Grid>
</Window>
